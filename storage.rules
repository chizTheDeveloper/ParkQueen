rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isValidAvatar() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Direct avatar file: client writes to avatars/{uid} (no subdirectory).
    // Explicit match because {allPaths=**} semantics for zero segments are
    // implementation-defined and must not be relied upon for security.
    match /avatars/{uid} {
      allow read:   if isOwner(uid);
      allow write:  if isOwner(uid) && isValidAvatar();
      allow delete: if isOwner(uid);
    }

    // Avatar in a subdirectory: avatars/{uid}/thumbnail, etc.
    match /avatars/{uid}/{allPaths=**} {
      allow read:   if isOwner(uid);
      allow write:  if isOwner(uid) && isValidAvatar();
      allow delete: if isOwner(uid);
    }

    // Default: deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
