{
  "name": "parqueen",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules:unit": "vitest run --config vite.rules.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-parkqueen-rules-test \"npm run test:rules:unit\"",
    "test:storage:rules:unit": "vitest run --config vite.storage-rules.config.ts",
    "test:storage:rules": "firebase emulators:exec --only storage \"npm run test:storage:rules:unit\"",
    "install:functions": "npm install --prefix functions",
    "test:functions": "firebase emulators:exec --only functions,firestore,auth,storage \"vitest run --config vite.functions.config.ts\"",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sentry/react": "^10.72.0",
    "expo": "~50.0.14",
    "expo-camera": "~14.1.1",
    "expo-location": "~16.5.5",
    "expo-status-bar": "~1.11.1",
    "firebase": "^10.8.0",
    "firebase-admin": "^13.6.1",
    "geofire-common": "^6.0.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.9",
    "lucide-react": "^0.344.0",
    "mapbox-gl": "^3.18.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-web": "~0.19.10",
    "react-native-webview": "13.8.6",
    "recharts": "^2.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "~18.2.45",
    "@types/react-test-renderer": "^18.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "react-test-renderer": "^18.2.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.1.3",
    "vite": "^5.1.4",
    "vitest": "^4.1.9"
  },
  "private": true
}
