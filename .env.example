VITE_MAPBOX_TOKEN=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=

# Client-visible — safe to embed. Enables production error monitoring; a
# missing value simply leaves it disabled (see utils/sentryInit.ts).
VITE_SENTRY_DSN=

# Build-time only — read via Vite's loadEnv in vite.config.ts, never exposed
# to client code. All three are required together for the Sentry Vite plugin
# to upload source maps; leaving any of them unset produces an ordinary
# build with no source maps generated at all (see sentryRelease.ts).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
