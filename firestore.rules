 rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    // ── Spot update helpers ───────────────────────────────────────────────────
    function isFinder() {
      return resource.data.finderId == request.auth.uid;
    }

    function isClaimer() {
      return resource.data.interestedUserId == request.auth.uid;
    }

    function isHoldClaimer() {
      return resource.data.claimedBy == request.auth.uid;
    }

    function isAvailableForClaim() {
      return resource.data.status == 'available'
        && resource.data.get('interestedUserId', null) == null
        && resource.data.get('holdRequestedBy', null) == null;
    }

    function isAvailableForHold() {
      return resource.data.status == 'available'
        && resource.data.get('interestedUserId', null) == null
        && resource.data.get('holdRequestedBy', null) == null;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── Avatar (Parsona) write guard ─────────────────────────────────────────
    // Validates the avatar map against the approved manifest.
    // Required fields must be strings matching known asset IDs.
    // Optional fields (facialHair, glasses, headwear) may be null.
    function isValidAvatarV1(av) {
      return av is map
        && av.keys().hasAll(['version','skin','face','hair','hairColor','facialHair','glasses','headwear','outfit','background'])
        && av.keys().hasOnly(['version','skin','face','hair','hairColor','facialHair','glasses','headwear','outfit','background'])
        && av.version == 1
        // Required string fields — validated against approved ID lists
        && av.skin in ['skin_01','skin_02','skin_03','skin_04','skin_05','skin_06']
        && av.face in ['face_round','face_oval','face_angular']
        && av.hair in ['hair_short','hair_medium_straight','hair_long','hair_short_curly','hair_afro','hair_locs','hair_braids','hair_bun','hair_wavy','hair_coily_short']
        && av.hairColor in ['hair_black','hair_dark_brown','hair_medium_brown','hair_auburn','hair_blonde','hair_gray']
        && av.outfit in ['outfit_tee','outfit_hoodie','outfit_jacket','outfit_turtleneck','outfit_buttonup']
        && av.background in ['bg_navy','bg_midnight','bg_teal','bg_charcoal','bg_purple','bg_gold']
        // Optional fields: null or an approved ID
        && (av.facialHair == null || av.facialHair in ['fh_stubble','fh_beard_short','fh_mustache'])
        && (av.glasses   == null || av.glasses   in ['gl_round','gl_square','gl_semi'])
        && (av.headwear  == null || av.headwear  in ['hw_cap','hw_hijab','hw_wrap','hw_beanie']);
    }

    function isValidAvatarV2(av) {
      return av is map
        && av.keys().hasAll(['version','baseStyle','skin','hair','accessory','top','background'])
        && av.keys().hasOnly(['version','baseStyle','skin','hair','accessory','top','background'])
        && av.version == 2
        && av.baseStyle in ['feminine','masculine']
        && av.skin in ['tone_01','tone_02','tone_03','tone_04','tone_05']
        && av.hair in ['short_fade','short_curls','medium_textured','long_hair','braids_locs']
        && (av.accessory == null || av.accessory in ['round_glasses','square_glasses','cap_beanie','head_covering'])
        && av.top in ['crew_neck','hoodie','structured_jacket','turtleneck','smart_casual']
        && av.background == 'parqueen_navy';
    }

    function isValidAvatarField() {
      let av = request.resource.data.get('avatar', null);
      return av == null || isValidAvatarV1(av) || isValidAvatarV2(av);
    }

    match /users/{userId} {
      allow read: if signedIn() || isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(
             ['dob', 'gender', 'homeArea', 'driverType', 'ageRange'])
        && isValidAvatarField();
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['crowns', 'title', 'trustScore', 'trustStats',
                            'moderationStatus', 'reportCount', 'role', 'status',
                            'suspendedAt', 'suspendedBy', 'suspensionReason',
                            'unsuspendedAt', 'unsuspendedBy', 'emailVerified',
                            'dob', 'gender', 'homeArea', 'driverType', 'ageRange'])
            && isValidAvatarField());
      allow delete: if false;

      match /processedTrustEvents/{eventId} {
        allow read, write: if false;
      }

      // Private demographic profile — owner-only; admin read for moderation
      match /private/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
        allow read: if isAdmin();
      }
    }

    match /spots/{spotId} {
      // Public-ish: available/interested spots are readable by any signed-in user (live Ping feed).
      // Occupied/history spots are private: only the finder, active claimer, or admin may read them.
      allow read: if signedIn() && (
        resource.data.status == 'available'
        || resource.data.status == 'interested'
        || resource.data.finderId == request.auth.uid
        || resource.data.get('interestedUserId', null) == request.auth.uid
        || resource.data.get('claimedBy', null) == request.auth.uid
        || isAdmin()
      );
      allow create: if signedIn() && request.resource.data.finderId == request.auth.uid;
      allow delete: if signedIn() && resource.data.finderId == request.auth.uid;
      allow update: if signedIn() && (

        // Arm 1: Claim an available spot (immediate or scheduled)
        (isAvailableForClaim()
          && request.resource.data.interestedUserId == request.auth.uid
          && request.resource.data.status == 'interested'
          && onlyChanges(['status', 'claimState', 'ownerLeavingNow', 'ownerLeavingNowAt',
                          'interestedUserId', 'interestedUserName',
                          'interestedUserVehicleColor', 'interestedUserVehicleType',
                          'interestedUserVehicleBrand', 'interestedUserTitle',
                          'etaMinutes', 'interestExpiresAt',
                          'claimReminderAt', 'claimReminderSentAt',
                          'claimAutoReleaseAt', 'claimAutoReleasedAt']))

        // Arm 2: Claimer updates ETA
        || (isClaimer() && onlyChanges(['etaMinutes']))

        // Arm 2b: Claimer commits to heading (scheduled → active)
        || (isClaimer()
          && request.resource.data.status == 'interested'
          && onlyChanges(['claimState', 'ownerLeavingNow', 'ownerLeavingNowAt',
                          'etaMinutes', 'interestExpiresAt',
                          'claimReminderAt', 'claimReminderSentAt', 'claimAutoReleaseAt']))

        // Arm 3: Claimer cancels — clears all claimer metadata
        || (isClaimer()
          && request.resource.data.status == 'available'
          && onlyChanges(['status', 'claimState', 'ownerLeavingNow', 'ownerLeavingNowAt',
                          'interestedUserId', 'interestedUserName',
                          'interestedUserVehicleColor', 'interestedUserVehicleType',
                          'interestedUserVehicleBrand', 'interestedUserTitle',
                          'etaMinutes', 'interestExpiresAt',
                          'claimReminderAt', 'claimReminderSentAt',
                          'claimAutoReleaseAt', 'claimAutoReleasedAt']))

        // Arm 4: Claimer marks arrived
        || (isClaimer()
          && request.resource.data.status == 'occupied'
          && onlyChanges(['status']))

        // Arm 5: Finder confirms arrival
        || (isFinder()
          && request.resource.data.status == 'occupied'
          && onlyChanges(['status']))

        // Arm 6: Finder extends claim expiry
        || (isFinder() && onlyChanges(['interestExpiresAt']))

        // Arm 6b: Finder signals they are leaving now (scheduled handoff)
        || (isFinder() && onlyChanges(['ownerLeavingNow', 'ownerLeavingNowAt', 'claimAutoReleaseAt']))

        // Arm 7: Finder accepts hold — old state must be pending, claimedBy must match requester
        || (isFinder()
          && resource.data.holdRequestStatus == 'pending'
          && resource.data.status == 'available'
          && resource.data.get('holdRequestedBy', null) != null
          && request.resource.data.holdRequestStatus == 'accepted'
          && request.resource.data.status == 'claimed'
          && request.resource.data.claimedBy == resource.data.holdRequestedBy
          && onlyChanges(['holdRequestStatus', 'status', 'claimedBy', 'holdTimerExpiresAt']))

        // Arm 8: Finder declines hold — old state must be pending
        || (isFinder()
          && resource.data.holdRequestStatus == 'pending'
          && resource.data.status == 'available'
          && request.resource.data.holdRequestStatus == 'declined'
          && request.resource.data.status == 'available'
          && request.resource.data.get('claimedBy', null) == null
          && onlyChanges(['holdRequestStatus', 'status', 'claimedBy']))

        // Arm 9: Send hold request — available spot, no active claim or hold
        || (isAvailableForHold()
          && request.resource.data.holdRequestedBy == request.auth.uid
          && request.resource.data.holdRequestStatus == 'pending'
          && onlyChanges(['holdRequestedBy', 'holdRequestedByName',
                          'holdRequestStatus', 'holdRequestExpiresAt']))

        // Arm 10: Hold claimer arrival release
        || (isHoldClaimer()
          && request.resource.data.holdRequestStatus == 'completed'
          && request.resource.data.status == 'occupied'
          && onlyChanges(['holdRequestStatus', 'status']))

        // Arm 11: Hold timer expiry — old state must be accepted; finder or claimer may execute
        || ((isFinder() || isHoldClaimer())
          && resource.data.holdRequestStatus == 'accepted'
          && resource.data.status == 'claimed'
          && request.resource.data.holdRequestStatus == 'declined'
          && request.resource.data.status == 'available'
          && request.resource.data.get('claimedBy', null) == null
          && onlyChanges(['holdRequestStatus', 'status', 'claimedBy']))
      );
    }

    match /listings/{listingId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /avatarModeration/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /emailVerificationCodes/{userId} {
      allow read, write: if false;
    }

    match /usernames/{usernameId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /moderationLog/{logId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    match /spotNotifications/{notifId} {
      allow read: if signedIn() && resource.data.targetUserId == request.auth.uid;
      allow create: if signedIn();
      allow delete: if signedIn() && resource.data.targetUserId == request.auth.uid;
    }

    match /spotFeedback/{feedbackId} {
      allow create: if signedIn();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /adminAuditLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /parkingSessions/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /parseFailures/{failureId} {
      allow read: if isAdmin();
      // Signed-in users may create new failure docs or increment count on existing ones
      allow create: if signedIn();
      allow update: if isAdmin() || (
        signedIn()
        // Users may only increment count and update lastSeenAt/location — not resolve/reopen
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['resolvedAt', 'resolvedBy', 'resolutionType', 'resolutionNote'])
      );
      allow delete: if false;
    }

    match /streetSegments/{segmentId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();

      match /streetRules/{ruleId} {
        allow read: if true;
        allow create: if isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // Collection group rule required for collectionGroup('streetRules') queries.
    // Nested subcollection rules only cover path-based access, not cross-collection queries.
    match /{path=**}/streetRules/{ruleId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /suspensions/{suspensionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /chats/{chatId} {
      allow read, write: if signedIn();
      
      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }
  }
}
