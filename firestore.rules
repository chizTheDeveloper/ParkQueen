 rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read: if signedIn() || isAdmin();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /spots/{spotId} {
      allow read: if signedIn() || isAdmin();
      allow create: if signedIn() && request.resource.data.finderId == request.auth.uid;
      allow delete: if signedIn() && resource.data.finderId == request.auth.uid;
      allow update: if signedIn();
    }

    match /listings/{listingId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /avatarModeration/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /emailVerificationCodes/{userId} {
      allow read, write: if false;
    }

    match /chats/{chatId} {
      allow read, write: if signedIn();
      
      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }
  }
}